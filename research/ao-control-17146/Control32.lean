def table : BitVec 1024 := 0xf2e8bac10a6043d9457138034725c66e70255481935a6c64005908b76782a258f242212a808cc37840c7587731c008681fe2432ed77945531ae8b7a126a59084808bb1419a92806024a6a4951998ca080462a035454001fbd121d148e7fc1805c0db52e001730db248cebe22450196149d550a91d225c20b821a462b02611918

theorem mono : Monotone2 circuit := by
  intro g hg
  obtain ⟨⟨b,i,j⟩, _, rfl⟩ := List.mem_map.mp (show g ∈ codes.map asGate from hg)
  cases b <;> simp [asGate]

theorem fan : FanInTwo circuit := by
  intro g hg
  obtain ⟨ho,hl⟩ := mono g hg
  refine ⟨?_,hl⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ho ⊢
  tauto

set_option maxHeartbeats 10000000 in
set_option maxRecDepth 100000 in
theorem raw_spec : ∀ u v : Fin 32,
    (raw.map fun w => w.getLsbD (32 * u.val + v.val)) = oneEach u v := by
  decide +kernel

set_option maxHeartbeats 10000000 in
set_option maxRecDepth 100000 in
theorem calculated : (circuit.gates.foldl hcsStep raw).getD circuit.output 0 = table := by
  decide +kernel

theorem target_spec : ∀ u v : Fin 32, table.getLsbD (32*u.val + v.val) = Nat.testBit 0xf2e8bac10a6043d9457138034725c66e70255481935a6c64005908b76782a258f242212a808cc37840c7587731c008681fe2432ed77945531ae8b7a126a59084808bb1419a92806024a6a4951998ca080462a035454001fbd121d148e7fc1805c0db52e001730db248cebe22450196149d550a91d225c20b821a462b02611918 (32*u.val+v.val) := by
  decide +kernel

end PEqualNP.Research.Control32

open PEqualNP.Research.Control32

set_option maxRecDepth 100000 in
theorem PEqualNP.Research.Control32 : PEqualNP.Represents.RepSizeAtMost (fun u v : Fin 32 => Nat.testBit 0xf2e8bac10a6043d9457138034725c66e70255481935a6c64005908b76782a258f242212a808cc37840c7587731c008681fe2432ed77945531ae8b7a126a59084808bb1419a92806024a6a4951998ca080462a035454001fbd121d148e7fc1805c0db52e001730db248cebe22450196149d550a91d225c20b821a462b02611918 (32 * u.val + v.val)) 251 := by

  refine ⟨circuit, mono, by decide +kernel, ?_⟩
  intro u v
  let r := 32 * u.val + v.val
  have hr : r < 1024 := by dsimp [r]; omega
  have hbits := hcsFoldBits raw ⟨r,hr⟩ circuit.gates fan
  change (circuit.gates.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun k => w.getD k false)])
    (PEqualNP.Represents.oneEach u v)).getD circuit.output false = _
  rw [← raw_spec u v, ← hbits, ← hcsGetDBit, calculated]
  exact target_spec u v
